# Database configurations
DB_PASSWORD=rootpassword

# Google Gemini API configurations (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT parameters (must be a Base64-encoded secret, 256 bits or more)
# Example secure key: dGhpcy1pcy1hLXNlY3VyZS1kZWZhdWx0LXNlY3JldC1rZXktZm9yLWFpLXNvZnR3YXJlLWFyY2hpdGVjdC1iYWNrZW5kLXByb2plY3Q=
JWT_SECRET=your_base64_encoded_jwt_secret_here

# Security cookies configuration (set to true if using HTTPS, false for local HTTP)
JWT_COOKIE_SECURE=false

# Frontend variables
VITE_API_BASE_URL=http://localhost:8080
